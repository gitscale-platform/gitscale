{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitscale.io/events/collaboration/issue_noise.released.schema.json",
  "title": "issue_noise.released",
  "description": "Emitted when a maintainer manually releases a held issue via plane/application/issuenoise.Router.Release. Issue: https://github.com/gitscale-platform/gitscale/issues/117.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_id",
    "repo_id",
    "maintainer_id",
    "released_at",
    "_envelope_version"
  ],
  "properties": {
    "issue_id": {
      "type": "string",
      "format": "uuid"
    },
    "repo_id": {
      "type": "string",
      "format": "uuid"
    },
    "maintainer_id": {
      "type": "string",
      "format": "uuid"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "_envelope_version": {
      "type": "integer",
      "const": 1
    }
  }
}
