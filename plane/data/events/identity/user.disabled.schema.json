{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitscale.io/events/identity/user.disabled.schema.json",
  "title": "user.disabled",
  "description": "Emitted when a HumanUser is soft-disabled. Payload of the identity_outbox row whose event_type = 'user.disabled'. Cache invalidator (#27) and audit consumers gate on this.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "user_id",
    "reason",
    "affected_principal_ids",
    "disabled_at",
    "_envelope_version"
  ],
  "properties": {
    "user_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string"
    },
    "affected_principal_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uuid" }
    },
    "disabled_at": {
      "type": "string",
      "format": "date-time"
    },
    "_envelope_version": {
      "type": "integer",
      "const": 1
    }
  }
}
