{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitscale.io/events/identity/org.member_removed.schema.json",
  "title": "org.member_removed",
  "description": "Emitted when an org membership is deleted. Payload of the identity_outbox row whose event_type = 'org.member_removed'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "org_id",
    "user_id",
    "affected_principal_ids",
    "removed_at",
    "_envelope_version"
  ],
  "properties": {
    "org_id": { "type": "string", "format": "uuid" },
    "user_id": { "type": "string", "format": "uuid" },
    "affected_principal_ids": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "format": "uuid" }
    },
    "removed_at": { "type": "string", "format": "date-time" },
    "_envelope_version": { "type": "integer", "const": 1 }
  }
}
